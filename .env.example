# ForgeIQ environment variables — copy to .env and fill in. NEVER commit .env.
# In production these are set as Railway environment variables.

# Supabase PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Anthropic key for entity resolution (claude-sonnet-4-6)
ANTHROPIC_API_KEY=sk-ant-...

# Paid ICEGATE import-data vendor (Zauba / Volza)
ZAUBA_API_KEY=

# Failure alerting
ALERT_WHATSAPP_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# API security — random 32-char string
SECRET_KEY=

# Startup behaviour (db/init_db.py)
# FORGEIQ_AUTO_INIT=1 makes the API apply schema + config seed on boot, so a
# fresh managed Postgres self-initializes (no manual SQL). Default on.
FORGEIQ_AUTO_INIT=1
# FORGEIQ_SEED_DEMO=1 also loads demo leads on boot — set for a first deploy so
# the dashboard isn't empty, then turn off. Demo API key: fiq_demo_key_2026
FORGEIQ_SEED_DEMO=0
