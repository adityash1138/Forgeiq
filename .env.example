# ForgeIQ environment variables — copy to .env and fill in. NEVER commit .env.
# In production these are set as Railway environment variables.

# Supabase PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Anthropic key for entity resolution (claude-sonnet-4-6)
ANTHROPIC_API_KEY=sk-ant-...

# Paid ICEGATE import-data vendor (Zauba / Volza)
ZAUBA_API_KEY=

# Failure alerting
ALERT_WHATSAPP_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# API security — random 32-char string
SECRET_KEY=
